{
  "version": 1,
  "authority": "https://oracleofrelphi.com/glyphs-unified-preview.html",
  "expectedBaseAssets": 93,
  "canvasPolicy": {
    "preserveViewBox": true,
    "preserveWhitespace": true,
    "preserveAuthoredGeometry": true,
    "preserveAuthoredPosition": true,
    "preserveAuthoredScale": true,
    "croppingAllowed": false,
    "visibleBoundsFittingAllowed": false,
    "innerTransformsAllowed": false
  },
  "states": {
    "plain": {
      "base": "canonical uncircled asset",
      "overlays": []
    },
    "ring": {
      "base": "canonical uncircled asset",
      "overlays": ["canonical single-ring overlay"]
    },
    "doubleRing": {
      "base": "canonical uncircled asset",
      "overlays": ["canonical double-ring overlay"]
    }
  },
  "allowedPresentation": [
    "outer width and height",
    "uniform scaling of the complete preserved-canvas asset",
    "approved color application",
    "opacity of the complete asset or complete approved overlay",
    "selection, hover, focus, and semantic state classes"
  ],
  "forbidden": [
    "fallback glyphs",
    "Unicode or font glyph substitution",
    "runtime circle creation",
    "runtime path creation",
    "runtime fitting",
    "getBBox or visible-bounds measurement",
    "viewBox rewriting",
    "cropping",
    "overflow clipping used to fit glyph geometry",
    "inner group scaling or translation",
    "path, circle, group, stroke, or coordinate editing by consumers",
    "consumer-defined radius or padding"
  ],
  "failurePolicy": "A missing canonical asset or state overlay must fail visibly and fail validation. It must never substitute another glyph or generated geometry."
}
