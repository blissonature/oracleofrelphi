{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oracleofrelphi.com/schemas/canonical-glyph-approval/overlay-approval-record.schema.json",
  "title": "Canonical glyph overlay approval record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type","state","candidate_sha256","source_path","z_order","approving_authority","approval_date","baseline_commit","reference_package_hash","decision_type","notes","geometry_confirmation","no_fallback_or_runtime_fitting_authorized","signature"],
  "properties": {
    "record_type": {"const":"overlay-approval"},
    "state": {"enum":["circled","day-ruler","hour-ruler","day-and-hour-ruler"]},
    "candidate_sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "source_path": {"type":"string","pattern":"^assets/canonical-glyphs/v1/overlays/.+\\.svg$"},
    "z_order": {"enum":["backplate","foreground"]},
    "approving_authority": {"type":"string","minLength":1},
    "approval_date": {"type":"string","format":"date"},
    "baseline_commit": {"type":"string","pattern":"^[a-f0-9]{40}$"},
    "reference_package_hash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "decision_type": {"enum":["approve-static-overlay","replace-approved-overlay"]},
    "notes": {"type":"string"},
    "geometry_confirmation": {"type":"object","additionalProperties":false,"required":["geometry","whitespace","scale","position","proportions","strokes"],"properties":{"geometry":{"const":true},"whitespace":{"const":true},"scale":{"const":true},"position":{"const":true},"proportions":{"const":true},"strokes":{"const":true}}},
    "no_fallback_or_runtime_fitting_authorized": {"const":true},
    "signature": {"type":"object","additionalProperties":false,"required":["algorithm","key_id","signed_payload_sha256","value"],"properties":{"algorithm":{"type":"string","minLength":1},"key_id":{"type":"string","minLength":1},"signed_payload_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"value":{"type":"string","minLength":1}}}
  }
}
