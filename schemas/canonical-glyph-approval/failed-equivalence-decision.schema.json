{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oracleofrelphi.com/schemas/canonical-glyph-approval/failed-equivalence-decision.schema.json",
  "title": "Failed equivalence decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type","identity","candidate_sha256","source_path","approving_authority","approval_date","baseline_commit","reference_package_hash","decision_type","notes","geometry_confirmation","no_fallback_or_runtime_fitting_authorized","signature"],
  "properties": {
    "record_type": {"const":"failed-equivalence-decision"},
    "identity": {"enum":["sun","moon","jupiter","pluto","virgo","capricorn"]},
    "candidate_sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "source_path": {"type":"string","minLength":1},
    "approving_authority": {"type":"string","minLength":1},
    "approval_date": {"type":"string","format":"date"},
    "baseline_commit": {"type":"string","pattern":"^[a-f0-9]{40}$"},
    "reference_package_hash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "decision_type": {"enum":["keep-unavailable","approve-named-baked-candidate","approve-named-existing-repository-source","supply-another-static-master"]},
    "notes": {"type":"string"},
    "geometry_confirmation": {"type":"object","additionalProperties":false,"required":["geometry","whitespace","scale","position","proportions","strokes"],"properties":{"geometry":{"type":"boolean"},"whitespace":{"type":"boolean"},"scale":{"type":"boolean"},"position":{"type":"boolean"},"proportions":{"type":"boolean"},"strokes":{"type":"boolean"}}},
    "no_fallback_or_runtime_fitting_authorized": {"const":true},
    "signature": {"type":"object","additionalProperties":false,"required":["algorithm","key_id","signed_payload_sha256","value"],"properties":{"algorithm":{"type":"string","minLength":1},"key_id":{"type":"string","minLength":1},"signed_payload_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"value":{"type":"string","minLength":1}}}
  }
}
