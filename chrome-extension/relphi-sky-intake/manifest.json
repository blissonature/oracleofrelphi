{
  "manifest_version": 3,
  "name": "Oracle of Relphi — Sky from Selection",
  "version": "0.1.0",
  "description": "Open highlighted dates, addresses or complete Where and When in Sky Chart.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open selected Where and When in Sky Chart"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "recognizer.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
