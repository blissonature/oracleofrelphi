      "title": "Opposite Signs",
      "course": "AST101",
      "pythonConcept": "list indexing + modulo 12",
      "summary": "Add six signs and wrap around the zodiac.",
      "status": "interactive",
      "inputs": {
        "sign": [
          "Aries",
          "Taurus",
          "Gemini",
          "Cancer",
          "Leo",
          "Virgo",
          "Libra",
          "Scorpio",
          "Sagittarius",
          "Capricorn",
          "Aquarius",
          "Pisces"
        ]
      },
      "code": "signs = [\"Aries\",\"Taurus\",\"Gemini\",\"Cancer\",\"Leo\",\"Virgo\",\\n         \"Libra\",\"Scorpio\",\"Sagittarius\",\"Capricorn\",\"Aquarius\",\"Pisces\"]\\n\\ni = signs.index(sign)\\nprint(signs[(i + 6) % 12])"
    },
